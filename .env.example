# Public origin advertised in 402 resource.url (must be https in production)
PUBLIC_BASE_URL=http://127.0.0.1:4021
# Optional external swarm discovery URL. This service only advertises it and never calls it.
# SWARM_PUBLIC_URL=https://your-swarm.example

# Seller receive address ONLY (0x + 40 hex). Never a private key.
X402_PAY_TO=0x05e1720bB82F86B5bc7940a99FDC702E32256357

# Mainnet Base. Local demo may use eip155:84532.
X402_NETWORK=eip155:8453

# Production mainnet facilitator (CDP). x402.org is Sepolia-oriented — not the mainnet default.
X402_FACILITATOR_URL=https://api.cdp.coinbase.com/platform/v2/x402
FACILITATOR_TIMEOUT_MS=10000

# CDP Secret API key (JWT on verify/settle). Receive-address only — not a wallet key.
# Create at https://portal.cdp.coinbase.com/api-keys/secret (Ed25519).
# CDP_API_KEY_ID=
# CDP_API_KEY_SECRET=

# Hard cap for any paid tool / A2A task (USD)
MAX_PRICE_USD=25

# true = local DemoFacilitator (CI / laptop http). HTTPS public hosts ignore this unless DEMO_ALLOW_PUBLIC=true.
DEMO_MODE=true
# DEMO_ALLOW_PUBLIC=false

# Optional second facilitator when CDP verify/settle returns 401/403 (no CDP JWT on host).
# PayAI free tier supports Base mainnet x402 v2 with no API key. x402.org is Sepolia-only.
# X402_FACILITATOR_URL_FALLBACK=https://facilitator.payai.network

PORT=4021
HOST=127.0.0.1

# Optional LLM for paid consults. If unset, Oracle uses live-protocol knowledge fallback.
# ORACLE_LLM_API_KEY=
# ORACLE_LLM_BASE_URL=https://api.x.ai/v1
# ORACLE_LLM_MODEL=grok-4
LLM_TIMEOUT_MS=30000

# NEVER set EVM_PRIVATE_KEY on Vercel/Render. Buyer keys stay on the operator laptop.

# Comma-separated wallets treated as operator self-settles (not external demand).
# OPERATOR_WALLETS=0x...,0x...

# Optional on-disk ledger dir (defaults to ./ledger). On Vercel, revenue is in-memory per isolate unless you add Redis later.
# LEDGER_DIR=./ledger
