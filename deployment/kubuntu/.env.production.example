# Copy to .env.production, set mode 0600, and never commit it.
PUBLIC_BASE_URL=https://oracle.example.com
SWARM_PUBLIC_URL=https://swarm.example.com
SWARM_BUILD_CONTEXT=../../../x402-crediting-swarm

X402_NETWORK=eip155:8453
X402_PAY_TO=0x0000000000000000000000000000000000000000
X402_FACILITATOR_URL=https://api.cdp.coinbase.com/platform/v2/x402
X402_FACILITATOR_URL_FALLBACK=https://facilitator.payai.network
X402_EVAL_PRICE='$0.05'
MAX_PRICE_USD=25

CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# Optional inference. Deterministic fallbacks remain available when unset.
ORACLE_LLM_API_KEY=
ORACLE_LLM_BASE_URL=
ORACLE_LLM_MODEL=
AI_GATEWAY_API_KEY=
SWARM_MODEL=
